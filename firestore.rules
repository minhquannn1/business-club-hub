rules_version = '2';

// Business Club Hub security rules.
// Club members (role exec or member) can read the workspace.
// Admins (exec with admin: true) can change everything, including people and roles.
// Exec members create projects and tasks and post announcements; money and the website
// need the 'finance' or 'website' permission in their perms list.
// Project leads can change their own project and its tasks; everyone can tick off their own tasks.
// Guests (role guest) are people outside the club who help on certain projects: they only see
// the projects they are on, the tasks given to them and the meetings they attended.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedIn() && myEmail() == 'minhquan.n.student@isph.edu.vn';
    }
    function memberPath() {
      return /databases/$(database)/documents/members/$(myEmail());
    }
    // anyone on the list, club member or guest
    function onList() {
      return signedIn() && (isOwner() || exists(memberPath()));
    }
    function isGuest() {
      return signedIn() && !isOwner() && exists(memberPath()) && get(memberPath()).data.get('role', 'member') == 'guest';
    }
    // club members only
    function isMember() {
      return isOwner() || (onList() && get(memberPath()).data.get('role', 'member') != 'guest');
    }
    function isExec() {
      return isOwner() || (signedIn() && exists(memberPath()) && get(memberPath()).data.role == 'exec');
    }
    function isAdmin() {
      return isOwner() || (isExec() && get(memberPath()).data.get('admin', false) == true);
    }
    // 'finance' or 'website'
    function canDo(perm) {
      return isAdmin() || (isExec() && perm in get(memberPath()).data.get('perms', []));
    }
    function projectPath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId);
    }
    function leads(projectId) {
      return onList() && projectId is string && projectId != ''
        && exists(projectPath(projectId))
        && get(projectPath(projectId)).data.leadEmail == myEmail();
    }
    // a guest who is on this project's team or leads it
    function guestOn(projectId) {
      return isGuest() && projectId is string && projectId != ''
        && exists(projectPath(projectId))
        && (myEmail() in get(projectPath(projectId)).data.get('teamEmails', [])
            || get(projectPath(projectId)).data.leadEmail == myEmail());
    }
    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- public website ----------
    match /site/{doc} {
      allow read: if true;
      allow write: if canDo('website');
    }
    match /publicProjects/{id} {
      allow read: if true;
      allow write: if isExec() || (isMember() && leads(id));
    }
    match /publicTeam/{id} {
      allow read: if true;
      allow write: if canDo('website') || (isMember() && id == myEmail().replace('[^a-z0-9]', '_'));
    }

    // ---------- people ----------
    match /members/{email} {
      allow read: if onList() || (signedIn() && email == myEmail());
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (onList() && email == myEmail() && changesOnly(['name', 'photoURL', 'sitePhoto', 'bio', 'uid', 'lastSeenAt', 'showOnSite', 'emailOff']));
      allow delete: if isAdmin() && email != 'minhquan.n.student@isph.edu.vn';
    }

    // ---------- work ----------
    match /projects/{id} {
      allow read: if isMember()
        || (isGuest() && (resource.data.leadEmail == myEmail() || myEmail() in resource.data.teamEmails));
      allow create: if isExec();
      allow delete: if isAdmin();
      allow update: if isExec()
        || (leads(id) && request.resource.data.leadEmail == resource.data.leadEmail);
    }

    // a task can have several people on it: assigneeEmails lists them all, assigneeEmail keeps the first
    function onTask(data) {
      return data.assigneeEmail == myEmail() || myEmail() in data.get('assigneeEmails', []);
    }
    // a task that is only for the person writing it
    function onlyMine(data) {
      return data.assigneeEmail == myEmail() && data.get('assigneeEmails', [myEmail()]).hasOnly([myEmail()]);
    }
    match /tasks/{id} {
      allow read: if isMember()
        || (isGuest() && (resource.data.assigneeEmail == myEmail() || myEmail() in resource.data.assigneeEmails));
      allow create: if onList() && request.resource.data.createdBy == myEmail()
        && (isExec()
            || (isMember() && (leads(request.resource.data.projectId) || onlyMine(request.resource.data)))
            || (isGuest() && onlyMine(request.resource.data)
                && (request.resource.data.projectId == '' || guestOn(request.resource.data.projectId))));
      allow update: if isExec()
        || (isMember() && leads(resource.data.projectId))
        || (onList() && resource.data.createdBy == myEmail() && onlyMine(resource.data)
            && onlyMine(request.resource.data)
            && request.resource.data.projectId == resource.data.projectId)
        || (isMember() && resource.data.createdBy == myEmail() && onlyMine(resource.data)
            && onlyMine(request.resource.data)
            && (request.resource.data.projectId == '' || leads(request.resource.data.projectId)))
        || (onList() && onTask(resource.data) && changesOnly(['status', 'updatedAt', 'completedAt']));
      allow delete: if isExec()
        || (isMember() && leads(resource.data.projectId))
        || (onList() && resource.data.createdBy == myEmail() && onlyMine(resource.data));
    }

    match /meetings/{id} {
      allow read: if isMember() || (isGuest() && myEmail() in resource.data.attendees);
      allow create: if isMember() && request.resource.data.createdBy == myEmail();
      allow update, delete: if isExec()
        || (isMember() && resource.data.createdBy == myEmail())
        || (isMember() && leads(resource.data.projectId));
    }

    match /activity/{id} {
      allow read: if isMember();
      allow create: if onList() && request.resource.data.actorEmail == myEmail();
      allow update, delete: if false;
    }

    // ---------- money (club only) ----------
    match /sheets/{sheetId} {
      allow read: if isMember();
      allow write: if canDo('finance');
      match /rows/{rowId} {
        allow read: if isMember();
        allow write: if canDo('finance');
      }
    }
    match /{path=**}/rows/{rowId} {
      allow read: if isMember();
    }
    match /receipts/{id} {
      allow read: if isMember();
      allow write: if canDo('finance');
    }

    // ---------- planning (club only) ----------
    match /schoolDates/{id} {
      allow read: if isMember();
      allow write: if isExec();
    }
    match /links/{id} {
      allow read: if isMember();
      allow write: if isExec();
    }

    // ---------- competition deliverables ----------
    // Club members can read them; the exec team and the competition's lead and team
    // (guests included) can write. Comments are open to anyone who can read.
    function onTeam(projectId) {
      return onList() && projectId is string && projectId != ''
        && exists(projectPath(projectId))
        && (get(projectPath(projectId)).data.leadEmail == myEmail()
            || myEmail() in get(projectPath(projectId)).data.get('teamEmails', []));
    }
    function canWriteFor(projectId) {
      return isExec() || onTeam(projectId);
    }
    function canReadFor(projectId) {
      return isMember() || onTeam(projectId);
    }
    function delivProject(id) {
      return get(/databases/$(database)/documents/deliverables/$(id)).data.projectId;
    }
    match /deliverables/{id} {
      allow read: if canReadFor(resource.data.projectId);
      allow create: if canWriteFor(request.resource.data.projectId) && request.resource.data.createdBy == myEmail();
      allow update: if canWriteFor(resource.data.projectId) && request.resource.data.projectId == resource.data.projectId;
      allow delete: if isExec() || leads(resource.data.projectId);

      match /sections/{sid} {
        allow read: if canReadFor(delivProject(id));
        allow write: if canWriteFor(delivProject(id));
      }
      match /versions/{vid} {
        allow read: if canReadFor(delivProject(id));
        allow create: if canWriteFor(delivProject(id)) && request.resource.data.by == myEmail();
        allow delete: if isExec() || leads(delivProject(id));
      }
      // who has it open right now; each person only writes their own entry
      match /presence/{who} {
        allow read: if canReadFor(delivProject(id));
        allow create, update: if canReadFor(delivProject(id)) && who == myEmail() && request.resource.data.email == myEmail();
        allow delete: if who == myEmail() || isExec() || leads(delivProject(id));
      }
      match /comments/{cid} {
        allow read: if canReadFor(delivProject(id));
        allow create: if canReadFor(delivProject(id)) && request.resource.data.by == myEmail();
        allow update: if canWriteFor(delivProject(id)) || resource.data.by == myEmail();
        allow delete: if isExec() || leads(delivProject(id)) || resource.data.by == myEmail();
      }
    }

    // ---------- announcements (club only; emails are sent by the server) ----------
    match /announcements/{id} {
      allow read: if isMember();
      allow create: if isExec() && request.resource.data.createdBy == myEmail()
        && !('emailedAt' in request.resource.data);
      allow delete: if isExec();
      allow update: if false;
    }
  }
}
