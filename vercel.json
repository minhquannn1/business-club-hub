{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "business-club-hub.vercel.app" }],
      "destination": "https://isphbusiness.club/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://business-club-hub.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://business-club-hub.firebaseapp.com/__/firebase/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
